<odoo>
    <data>
        <!-- Access rights for audit model -->
        <record id="group_audit_user" model="res.groups">
            <field name="name">Force Logout Audit User</field>
            <field name="category_id" ref="base.category_authentication"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <record id="group_audit_manager" model="res.groups">
            <field name="name">Force Logout Audit Manager</field>
            <field name="category_id" ref="base.category_authentication"/>
            <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <!-- Access Control List for audit model -->
        <record model="ir.model.access" id="access_auth_session_logout_audit_user">
            <field name="name">auth.session.logout.audit user</field>
            <field name="model_id" model="ir.model" search="[('model', '=', 'auth.session.logout.audit')]"/>
            <field name="group_id" ref="group_audit_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record model="ir.model.access" id="access_auth_session_logout_audit_manager">
            <field name="name">auth.session.logout.audit manager</field>
            <field name="model_id" model="ir.model" search="[('model', '=', 'auth.session.logout.audit')]"/>
            <field name="group_id" ref="group_audit_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Rule: Users can only see their own audit logs -->
        <record id="rule_auth_session_logout_audit_user" model="ir.rule">
            <field name="name">User can only see their own force logout logs</field>
            <field name="model_id" ref="model_auth_session_logout_audit"/>
            <field name="domain_force">[('target_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rule: Audit users can see all logs -->
        <record id="rule_auth_session_logout_audit_group" model="ir.rule">
            <field name="name">Audit group can see all force logout logs</field>
            <field name="model_id" ref="model_auth_session_logout_audit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_audit_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>