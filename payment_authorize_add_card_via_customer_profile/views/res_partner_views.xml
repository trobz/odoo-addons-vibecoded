<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_add_authorize_card" model="ir.ui.view">
            <field name="name">res.partner.form.add.authorize.card</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_payment_tokens" type="object" class="oe_stat_button" icon="fa-credit-card">
                        <field name="payment_token_count" widget="statinfo" string="Payment Tokens"/>
                    </button>
                </xpath>
                <xpath expr="//sheet" position="inside">
                    <header position="inside">
                        <button name="action_add_authorize_card" type="object" string="Add Authorize.net Card" class="btn-primary"
                                attrs="{'invisible': [('customer_rank', '=', 0)]}"/>
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
